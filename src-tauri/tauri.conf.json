{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "inkuo",
  "version": "0.1.0",
  "identifier": "com.inkuo.app",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "inkuo",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "inkuo team",
    "category": "Productivity",
    "shortDescription": "AI Document Assistant",
    "longDescription": "InkUO is a desktop AI assistant for everyday documents. Open a folder, tell it what you need, and it searches your files, drafts new documents, polishes reports, and edits Word, Excel, PPT, and Markdown files for you. Designed for non-technical users.",
    "copyright": "Copyright (c) 2026 inkuo team",
    "homepage": "https://github.com/inkuo/inkuo",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
