# PostgreSQL password (change in production)
POSTGRES_PASSWORD=inkuo_change_me_in_production

# JWT signing secret - MUST be at least 32 characters of random data
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-openssl-rand-base64-48-output

# Admin token for Billing service /admin endpoints (creating invite codes, redemption codes).
# MUST be set in production; the service refuses to start with a placeholder.
ADMIN_TOKEN=replace-with-a-secret-admin-token

# Admin web UI seed credentials (only used on first startup to create the superadmin).
# Both MUST be set; the service refuses to start if they are missing or shorter than 12 chars.
# Generate with: openssl rand -base64 24
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=replace-with-a-strong-password-at-least-12-chars