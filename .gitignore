# Local embedding models and caches
src-tauri/.fastembed_cache/
src-tauri/models/

# Rust build artifacts (Cargo/Cargo.lock is committed intentionally;
# target/ is reproducible and can be regenerated by `cargo build`)
src-tauri/target/
/target/

# Local-only test/scratch workspace (never commit)
test（nogit）/
# test/ is the user's runtime scratch dir for one-off agent runs and
# regenerable output samples (docx / pptx / svg / png / py). Anything
# real lives under test/slides/ (committed demo assets) or under
# dedicated test infrastructure; everything else is throwaway.
test/*
!test/slides/

# workspace-local inkuo runtime data (snapshots, knowledge cache, etc.)
.inkuo/
.incode/

# SSH keys / secrets (never commit)
*.pem

# Windows installer toolchain scratch files (NSIS extracted into project root
# on 2026-07-11 cross-compile attempt — keep out of the repo)
$PLUGINSDIR/
Bin/
COPYING
Contrib/
Docs/
Examples/
Include/
NSIS.chm
NSIS.exe
Plugins/
Stubs/
makensis.exe
makensisw.exe
nsisconf.nsh
uninst-nsis.exe

# WiX toolchain scratch files
wix*.exe
wix*.zip

# Claude / AI assistant working dirs
.claude/
.crs/

# Cursor / AI local memory + migration backups (workspace-local, never commit)
.ai-memory/
